# Copy this file to .env and replace the placeholder values for your local environment.
# Do not commit your real .env file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

PORT=8080
POSTGRES_DB=OnlineQuotes
POSTGRES_USER=quoteuser
POSTGRES_PASSWORD=change_me

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/OnlineQuotes
SPRING_DATASOURCE_USERNAME=quoteuser
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_SHOW_SQL=false

